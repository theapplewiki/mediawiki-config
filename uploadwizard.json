{
	"uwLanguages": {
		"en": "English"
	},

	"tutorial": {
		"skip": true
	},

	"feedbackLink": false,
	"alternativeUploadToolsPage": false,
	"maxUploads": 10,

	"licenses": {
		"screenshot": {
			"msg": "mwe-upwiz-license-screenshot-text"
		},

		"product image": {
			"msg": "mwe-upwiz-license-product-text"
		},

		"extracted image": {
			"msg": "mwe-upwiz-license-extracted-text"
		}
	},

	"licensing": {
		"ownWork": {
			"type": "or",
			"template": "self",
			"licenses": [
				"cc-zero",
				"cc-by-4.0",
				"cc-by-sa-4.0"
			]
		},

		"thirdParty": {
			"type": "or",
			"licenseGroups": [
				{
					"head": "mwe-upwiz-license-yes-head",
					"subhead": "mwe-upwiz-license-yes-subhead",
					"licenses": [
						"cc-zero",
						"cc-by-4.0",
						"cc-by-3.0",
						"cc-by-sa-4.0",
						"cc-by-sa-3.0"
					]
				},

				{
					"head": "mwe-upwiz-license-copyright-head",
					"subhead": "mwe-upwiz-license-copyright-subhead",
					"licenses": [
						"screenshot",
						"product image",
						"extracted image"
					]
				},

				{
					"head": "mwe-upwiz-license-no-head",
					"subhead": "mwe-upwiz-license-no-subhead",
					"defaults": ["none"],
					"licenses": ["none"]
				},

				{
					"head": "mwe-upwiz-license-other-head",
					"special": "custom",
					"defaults": ["custom"],
					"licenses": ["custom"]
				}
			]
		}
	}
}
